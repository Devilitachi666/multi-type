{
  "version": 2,

  "builds": [
    {
      "src": "api/sources.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/movies.js",
      "use": "@vercel/node"
    }
  ],

  "routes": [
    {
      "src": "/api/sources",
      "dest": "/api/sources.js"
    },
    {
      "src": "/api/movies",
      "dest": "/api/movies.js"
    },
    {
      "src": "/hls/(.*)",
      "dest": "/hls/$1"
    }
  ]
}
